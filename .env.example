# Gemini API Key (Required - Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# NASA API Key (Optional - free from https://api.nasa.gov/, defaults to DEMO_KEY)
NASA_API_KEY=DEMO_KEY

# YouTube Data API v3 OAuth Credentials (Optional - only needed for automated upload)
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN_SCIENCE=your_science_channel_refresh_token
YOUTUBE_REFRESH_TOKEN_HISTORY=your_history_channel_refresh_token
